# breach-exit settings — copy to .env next to docker-compose.yml.
# These only SEED a fresh /etc/breach volume; once state exists it wins.

# Pinning a release tag is safer than :latest for a server you don't watch.
BREACH_IMAGE=ghcr.io/getbreach/breach-exit:latest

# Which inner protocols this exit serves — a COMMA-SEPARATED LIST, since the
# relay dispatches per client and one exit can serve any mix at once:
#   wg     WireGuard. The only one needing --cap-add NET_ADMIN, /dev/net/tun
#          and ip_forward.
#   hy2    Hysteria2. Capless.
#   socks  STREAM mode: breach-server dials out itself, so the client offers a
#          local SOCKS5 proxy and needs no tun (no root). Capless, and needs no
#          extra port — it rides the relay port on loopback. The client's token
#          and the exit's certificate pin come in the provision block.
#   both   shorthand for wg,hy2      all  shorthand for wg,hy2,socks
#
# Examples:  PROTO=hy2        PROTO=hy2,socks        PROTO=wg,hy2,socks
# PROTO=hy2,socks is the light one: no caps, no tun, and clients may use either.
PROTO=both

# Public UDP port the MAX TURN relay delivers to. Open it in the VPS firewall.
RELAY_PORT=48000

# ip:port advertised to clients. Empty -> autodetect via api.ipify.org.
# Set it explicitly behind NAT or on a multi-IP box.
PUBLIC_ENDPOINT=

# TLS SNI on the Hysteria2 self-signed cert (clients pin it, insecure=true).
HY2_SNI=www.bing.com

# info | debug | trace
LOG_LEVEL=info

# breach-server per-stream keepalive (ms, clamped 20-500 client-side).
KEEPALIVE_MS=50

# Management API (breach-mgmt): 1 starts the fixed-verb HTTPS admin service so the
# app can add/list/remove clients + read stats WITHOUT SSH; 0 keeps the exit
# SSH-only. Only has effect when the image was built with --build-arg MGMT=1
# (the published image is). It listens on MGMT_PORT/tcp (default = RELAY_PORT);
# open that TCP port in the firewall too. The handle (url + secret + cert pin) is
# printed at first boot and saved to the volume as /etc/breach/mgmt.json.
MGMT_ENABLE=1
# TCP port for the management API. Compose default is 48000; install.sh sets it to
# RELAY_PORT so mgmt shares the relay port number (UDP relay + TCP mgmt can share
# one number). If you change RELAY_PORT and run compose directly, set MGMT_PORT to
# match. Open this TCP port in the firewall too.
#MGMT_PORT=48000
